      </column>
      <column caption='Discount_Rate' datatype='real' name='[Calculation_2041585041121280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Discount_Amount]) * 100.0) / SUM([Original_Price])' />
      </column>
      <column caption='Hour_Sort' datatype='integer' name='[Calculation_2041585046654978]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, DATETIME([Purchase_Time]))' />
      </column>
      <column caption='Purchase_Hour' datatype='string' name='[Calculation_2041585046814723]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;, DATETIME([Purchase_Time])) = 0 THEN &quot;12 AM&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, DATETIME([Purchase_Time])) &lt; 12 THEN STR(DATEPART(&apos;hour&apos;, DATETIME([Purchase_Time]))) + &quot; AM&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, DATETIME([Purchase_Time])) = 12 THEN &quot;12 PM&quot;&#13;&#10;ELSE STR(DATEPART(&apos;hour&apos;, DATETIME([Purchase_Time])) - 12) + &quot; PM&quot;&#13;&#10;END' />
      </column>
      <column caption='Zero_Axis' datatype='integer' name='[Calculation_2041585050894340]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Railcard_Type' datatype='string' name='[Calculation_2041585052721157]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Railcard] = &quot;None&quot; THEN &quot;No Railcard&quot;&#13;&#10;ELSE &quot;Has Railcard&quot;&#13;&#10;END' />
      </column>
      <column caption='Railcard_Cleaned' datatype='string' name='[Calculation_2041585054322694]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Railcard] &lt;&gt; &quot;None&quot; THEN [Railcard]&#13;&#10;END' />
      </column>
