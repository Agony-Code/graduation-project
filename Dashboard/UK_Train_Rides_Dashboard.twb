          <datasource-dependencies datasource='federated.0pl2ns61x0z9eo13do72b03wi55l'>
            <column caption='Departure_Hour' datatype='string' name='[Calculation_0304016166776833]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(&#13;&#10;&#13;&#10;IF DATEPART(&apos;hour&apos;, DATEPARSE(&quot;HH:mm:ss&quot;, [Departure_Time])) = 0 THEN 12&#13;&#10;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, DATEPARSE(&quot;HH:mm:ss&quot;, [Departure_Time])) &gt; 12 THEN&#13;&#10;DATEPART(&apos;hour&apos;, DATEPARSE(&quot;HH:mm:ss&quot;, [Departure_Time])) - 12&#13;&#10;&#13;&#10;ELSE&#13;&#10;DATEPART(&apos;hour&apos;, DATEPARSE(&quot;HH:mm:ss&quot;, [Departure_Time]))&#13;&#10;END&#13;&#10;&#13;&#10;)&#13;&#10;&#13;&#10;+&#13;&#10;&#13;&#10;IF DATEPART(&apos;hour&apos;, DATEPARSE(&quot;HH:mm:ss&quot;, [Departure_Time])) &lt; 12&#13;&#10;THEN &quot; AM&quot;&#13;&#10;ELSE &quot; PM&quot;&#13;&#10;END' />
            </column>
            <column caption='Hour_Sort' datatype='integer' name='[Calculation_0304016169037826]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEPART(&#13;&#10;&apos;hour&apos;,&#13;&#10;DATEPARSE(&quot;HH:mm:ss&quot;, [Departure_Time])&#13;&#10;)' />
            </column>
            <column caption='Departure Time' datatype='string' name='[Departure_Time]' role='dimension' type='nominal' />
