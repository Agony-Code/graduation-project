    <worksheet name='Cancellation Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#499894' fontsize='10'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Routes+ (Wameed_FinalSQL_Model)' name='federated.0pl2ns61x0z9eo13do72b03wi55l' />
          </datasources>
          <datasource-dependencies datasource='federated.0pl2ns61x0z9eo13do72b03wi55l'>
            <column caption='Cancellation_Rate' datatype='real' name='[Calculation_0461587205095428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM(IF [Trip_Status] = &quot;Cancelled&quot; THEN 1 ELSE 0 END) * 100.0)&#13;&#10;/ COUNTD([Trip_ID])' />
            </column>
            <column caption='Cancelled_Count' datatype='integer' name='[Calculation_0461587205861381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Trip_Status] = &quot;Cancelled&quot; THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Trip Date' datatype='date' name='[Trip_Date]' role='dimension' type='ordinal' />
            <column caption='Trip ID' datatype='integer' name='[Trip_ID]' role='dimension' type='ordinal' />
            <column caption='Trip Status' datatype='string' name='[Trip_Status]' role='dimension' type='nominal' />
            <column-instance column='[Trip_Date]' derivation='Month' name='[mn:Trip_Date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_0461587205095428]' derivation='User' name='[usr:Calculation_0461587205095428:qk]' pivot='key' type='quantitative' />
